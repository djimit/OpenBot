FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

# A small X11 desktop is the VM's visible computer. Openbox keeps the image
# materially lighter than a full desktop environment while still letting the
# user install and run ordinary graphical Linux applications. The desktop is
# reached only through the authenticated guest daemon; X11 never listens on the
# VM network.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      chromium \
      dbus-x11 \
      fonts-liberation \
      fonts-noto-color-emoji \
      openbox \
      scrot \
      xdotool \
      xterm \
      xvfb \
    && rm -rf /var/lib/apt/lists/*

CMD ["node", "/opt/openbot/vmDaemon.js"]
